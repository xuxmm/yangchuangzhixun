# 本地运行配置模板。复制为 .env 后填写；.env 严禁上传 GitHub。
# Render 上请在 Dashboard -> Environment 中设置同名变量。

# DeepSeek：负责全部文本分析、创新机会识别、方案生成与价值评估
LLM_API_MODE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TIMEOUT_SECONDS=60
LLM_QA_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=auto

# Agnes AI：仅用于产品外观图片生成
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.0-flash

# 本地启动参数；Render 会自动注入 PORT，并在 render.yaml 中设置 HOST=0.0.0.0
PORT=8787
HOST=127.0.0.1
HTML_FILE=index.html

# 可选：独立网页搜索 API，不是 DeepSeek 或 Agnes 的 Key
# TAVILY_API_KEY=

# 可选：限制允许访问的 Host，多个域名用英文逗号分隔；默认由同源校验保护
# ALLOWED_HOSTS=your-service.onrender.com
